STAGE3_CHECKPOINT=/absolute/path/model_high_freq_broadened.pth
STAGE4_CHECKPOINT=/absolute/path/model_stage4_candidate_conditioned.pt

# LOFTS0050 real-pair pilot
IRL_H5=/absolute/path/LOFTS0050.bary.0000_part000.h5
